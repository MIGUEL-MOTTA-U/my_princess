# my_princess — configuración de la demo
# Copia este archivo como `.env` y ajusta los valores. `.env` está en
# .gitignore: las keys nunca se commitean.

# ── LLM (agnóstico al proveedor vía LiteLLM) ─────────────────────────────
# Proveedor: gemini | openai | anthropic | ollama | cualquiera de LiteLLM
MP_LLM_PROVIDER=gemini
MP_LLM_MODEL=gemini-2.5-flash

# API key según el proveedor elegido (deja solo la que uses):
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Ollama no necesita key. Si corre en otro host, apunta el endpoint:
# MP_LLM_API_BASE=http://localhost:11434

# ── Rutas ────────────────────────────────────────────────────────────────
MP_WATCH_DIR=watchfolder
MP_OUTPUT_DIR=output
# Carpeta a la que el agente enruta la salida cuando la confianza supera el umbral
MP_APPROVED_DIR=approved
MP_DB_PATH=data/my_princess.db
MP_AI_NOTES_PATH=ai_notes.md

# ── Pipeline ─────────────────────────────────────────────────────────────
# Intervalo de polling del watchfolder (segundos)
MP_POLL_INTERVAL_SECONDS=2
# Reintentos por etapa antes de marcar FAILED
MP_MAX_RETRIES=3
# Umbral de triage del agente: confidence_score >= umbral -> salida en MP_APPROVED_DIR
MP_CONFIDENCE_THRESHOLD=0.8
# Modelo de faster-whisper: tiny | base | small | medium | large-v3
MP_WHISPER_MODEL=base
